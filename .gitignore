*.swp
*.swo
*~
~*
.*.swp
.*.swo
*.elc
auto-save-list
tramp
*.sublime-workspace
*.sublime-project

# ---------- 操作系统生成文件 ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
.directory
.Trash-*

# ---------- 日志与调试文件 ----------
*.log
*.sock
logs/
debug.log
error.log

# ---------- 测试覆盖率 ----------
coverage/
*.gcda
*.gcno
*.gcov
*.info
lcov/
.pytest_cache/

# ---------- 依赖管理 ----------
vendor/
node_modules/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
eggs/
.eggs/
wheels/
*.whl

# ---------- 文档生成 ----------
docs/_build/
doxygen/html/
doxygen/latex/
doxygen/xml/

# ---------- 临时文件 ----------
*.tmp
*.bak
*.temp
*.cache
*.pid
*.seed
*.pid.lock

# ---------- 性能分析 ----------
perf.data*
*.prof
gmon.out
callgrind.out.*

# ---------- 安全敏感文件（禁止入库） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
config.local.json
secrets.yml

# ---------- 数据库文件（开发用，测试夹具除外） ----------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
!tests/fixtures/*.db
!tests/fixtures/*.sqlite

# ---------- 特定于 heapstore 模块 ----------
# 测试输出
test_output/
test_results.xml
junit.xml
# 基准测试结果
benchmark_results/
performance_report.md
# 自动生成的代码
generated/
autogen/
# 备份文件
backup/
*.backup
*.orig

# =============================================================================
# 自定义钩子说明:
#
# 1. pre-commit: 检查大文件(>1MB)和行尾空格
# 2. pre-push: 运行快速测试套件
# 3. commit-msg: 验证消息格式
#
# 安装方式:
#   cp .git/hooks/pre-commit .git/hooks/pre-commit.sample
#   chmod +x .git/hooks/pre-commit
#
# =============================================================================
